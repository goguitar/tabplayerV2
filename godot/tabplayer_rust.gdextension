[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"

[libraries]
linux.debug.x86_64 = "res://bin/libgodot_bridge.so"
linux.release.x86_64 = "res://bin/libgodot_bridge.so"
windows.debug.x86_64 = "res://bin/godot_bridge.dll"
windows.release.x86_64 = "res://bin/godot_bridge.dll"
macos.debug = "res://bin/libgodot_bridge.dylib"
macos.release = "res://bin/libgodot_bridge.dylib"
